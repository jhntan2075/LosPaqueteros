# Variables de la API en la VM. Copiar a /etc/paqtracker/paqtracker.env (permisos 640, dueno
# root:paqtracker) y completar DB_PASSWORD. La lista completa de variables esta en el .env.example
# de la raiz; aqui solo van las que difieren del desarrollo local.

APP_HOST=127.0.0.1
APP_PORT=3000
APP_DATOS_VENTAS=/opt/paqtracker/datos/ventas.v20260909
APP_DATOS_BLOQUEOS=/opt/paqtracker/datos/bloqueos.v20260909
APP_ZONA_HORARIA=America/Lima

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paqtracker
DB_USER=paq_user
DB_PASSWORD=

# Login del equipo. Sin estos dos valores la API no arranca. El hash se genera con GeneradorHashClave
# (ver DESPLIEGUE-VM-PUCP.md, paso 4); aqui va tal cual, sin comillas.
APP_USUARIO=operaciones
APP_CLAVE_HASH=

PLANIFICADOR_ALGORITMO=GA
PLANIFICADOR_SEMILLA=1
