# Variables de entorno de PaqTracker (Twelve-Factor). Copiar a .env y completar.
# Este archivo documenta las variables; los valores son solo para desarrollo local.

# --- API de operacion (paqtracker-api) ---
# Interfaz y puerto de escucha. En la VM: 127.0.0.1 detras de Nginx. En Docker se fuerza 0.0.0.0.
APP_HOST=127.0.0.1
APP_PORT=3000
# Tamano maximo de archivo de pedidos/bloqueos subido (CU-02)
APP_MAX_ARCHIVO=20MB

# --- Base de datos (MySQL 8.0) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paqtracker
# Usuario propio de la aplicacion, con permisos minimos (nunca root)
DB_USER=paq_user
DB_PASSWORD=cambiar_en_local
# Solo lo usa el contenedor de MySQL al crearse; la aplicacion no lo lee
DB_ROOT_PASSWORD=cambiar_en_local_root

# --- Planificador ---
# Algoritmo de cada ciclo: GA | IACO
PLANIFICADOR_ALGORITMO=GA
# Semilla base del generador aleatorio (reproducibilidad)
PLANIFICADOR_SEMILLA=1
# Salto del algoritmo Sa: minutos simulados entre dos planificaciones (LE-058)
PLANIFICADOR_SA_MINUTOS=30

# --- Front web (paqtracker-web) ---
# En despliegue son relativas: Nginx sirve la SPA y reenvia /api y /ws a la API.
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
