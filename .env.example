# Variables de entorno previstas para la integracion del planificador con la API.
# Este archivo documenta las variables sin valores reales.

# Puerto en que la API expone el planificador
PAQTRACKER_PUERTO=8080

# Semilla base del generador aleatorio (reproducibilidad de los algoritmos)
PAQTRACKER_SEMILLA=1

# Paso del reloj de la simulacion dinamica, en minutos
PAQTRACKER_SA_MINUTOS=30

# Nivel de log del modulo (INFO, DEBUG, WARN, ERROR)
PAQTRACKER_LOG_NIVEL=INFO
