# Variables de entorno de PaqTracker (Twelve-Factor). Copiar a .env y completar.
# Este archivo documenta las variables; los valores son solo para desarrollo local.

# --- API de operacion (paqtracker-api) ---
# Interfaz y puerto de escucha. En la VM: 127.0.0.1 detras de Nginx. En Docker se fuerza 0.0.0.0.
APP_HOST=127.0.0.1
APP_PORT=3000
# Tamano maximo de archivo de pedidos/bloqueos subido (CU-02)
APP_MAX_ARCHIVO=20MB
# Carpetas de entrada (ventas.YYYYMM.txt y bloqueo.YYMM.txt). CU-02 guarda aqui los archivos subidos.
APP_DATOS_VENTAS=datos/ventas.v20260909
APP_DATOS_BLOQUEOS=datos/bloqueos.v20260909
# Zona horaria de la operacion (reloj real y fechas simuladas)
APP_ZONA_HORARIA=America/Lima
# Sc: segundos reales entre dos difusiones del estado por STOMP
APP_SC_SEGUNDOS=1
# Factor de aceleracion k (180: 5 dias simulados en 40 minutos reales)
APP_FACTOR_PERIODO=180
APP_FACTOR_COLAPSO=180
# Dias maximos de una simulacion de periodo y dias de datos que carga la de colapso
APP_DIAS_PERIODO_MAX=7
APP_DIAS_COLAPSO=30
# Pasos Sa como maximo por cada Sc, para seguir difundiendo si el planificador se atrasa
APP_MAX_PASOS_POR_TICK=4
# Simulaciones sin terminar que pueden existir a la vez (ademas del dia a dia); la VM tiene 2 vCPU
APP_MAX_SIMULACIONES=3
# Arrancar la operacion dia a dia al iniciar la API
APP_DIA_A_DIA_ACTIVO=true
# Semaforo: holgura restante como fraccion del plazo del pedido
APP_SEMAFORO_ROJO=0.15
APP_SEMAFORO_AMBAR=0.40

# --- Base de datos (MySQL 8.0) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paqtracker
# Usuario propio de la aplicacion, con permisos minimos (nunca root)
DB_USER=paq_user
DB_PASSWORD=cambiar_en_local
# Solo lo usa el contenedor de MySQL al crearse; la aplicacion no lo lee
DB_ROOT_PASSWORD=cambiar_en_local_root

# --- Planificador ---
# Algoritmo de cada ciclo: GA | IACO
PLANIFICADOR_ALGORITMO=GA
# Semilla base del generador aleatorio (reproducibilidad)
PLANIFICADOR_SEMILLA=1
# Salto del algoritmo Sa: minutos simulados entre dos planificaciones (LE-058)
PLANIFICADOR_SA_MINUTOS=30

# --- Front web (paqtracker-web) ---
# En despliegue son relativas: Nginx sirve la SPA y reenvia /api y /ws a la API.
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws
