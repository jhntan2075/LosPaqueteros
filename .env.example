# Variables de entorno del planificador PaqTracker (Twelve-Factor).
# Copiar a .env y completar. Este archivo documenta las variables sin valores reales.
# Los argumentos de linea de comandos (p. ej. --algoritmo) tienen prioridad sobre estas variables.

# --- Planificador ---
# Algoritmo de cada ciclo: GA | IACO
PLANIFICADOR_ALGORITMO=GA
# Semilla base del generador aleatorio (reproducibilidad)
PLANIFICADOR_SEMILLA=1
# Salto del algoritmo Sa: minutos simulados entre dos planificaciones (LE-058)
PLANIFICADOR_SA_MINUTOS=30

# --- Previstas para la integracion con paqtracker-api (aun no se leen) ---
# APP_PORT=3000
# PLANIFICADOR_TIEMPO_MAX_MS=5000
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
